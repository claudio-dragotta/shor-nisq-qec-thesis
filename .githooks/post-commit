#!/bin/sh
# Auto-pubblica il mirror ripulito sul repo pubblico quando un commit tocca file
# RILEVANTI per il pubblico. Il flag di attivazione:
#     git config tesi.autopublish true      # attiva
#     git config tesi.autopublish false     # disattiva
[ "$(git config --bool tesi.autopublish 2>/dev/null)" = "true" ] || exit 0

# File cambiati in questo commit, ESCLUSI quelli che non finiscono nel pubblico.
# Se non resta nulla, il commit non interessa il repo pubblico -> niente sync.
changed=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -viE \
  '(^_archivio/|^Extra/(articoli|tesi_esterne)/|^diario_relatore\.md$|\.(docx|mp4|mp3|m4a|wav|mov)$)' || true)

if [ -z "$changed" ]; then
  echo "[post-commit] nessun file rilevante per il pubblico: mirror non aggiornato."
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
echo "[post-commit] file pubblici modificati -> aggiorno il repo pubblico in background (log: .git/publish-public.log)"
# In background e staccato, cosi' il commit non resta in attesa del push.
( sh "$ROOT/scripts/publish-public.sh" >"$ROOT/.git/publish-public.log" 2>&1 & ) >/dev/null 2>&1
