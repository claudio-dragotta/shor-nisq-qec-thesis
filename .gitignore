.vscode/

# La demo e' un repo git separato con un remote suo. Qui entra come
# submodule: il repo della tesi registra QUALE commit della demo va con
# quale stato della tesi, e un clone --recurse-submodules ricostruisce la
# cartella. I file restano nel repo della demo, non duplicati qui.

__pycache__/
*.pyc
*.pyo

# Artefatti build LaTeX
file_latex/*.aux
file_latex/*.log
file_latex/*.bbl
file_latex/*.bcf
file_latex/*.blg
file_latex/*.lof
file_latex/*.lot
file_latex/*.out
file_latex/*.run.xml
file_latex/*.toc
file_latex/*.synctex.gz
file_latex/*.fdb_latexmk
file_latex/*.fls
file_latex/main.pdf

# Artefatti build LaTeX -- sommario (stesse regole di file_latex/)
file_latex_sommario/*.aux
file_latex_sommario/*.log
file_latex_sommario/*.bbl
file_latex_sommario/*.bcf
file_latex_sommario/*.blg
file_latex_sommario/*.lof
file_latex_sommario/*.lot
file_latex_sommario/*.out
file_latex_sommario/*.run.xml
file_latex_sommario/*.toc
file_latex_sommario/*.synctex.gz
file_latex_sommario/*.fdb_latexmk
file_latex_sommario/*.fls
file_latex_sommario/main.pdf

# Anteprime .png dei generatori: rigenerabili da figure_src/*.py.
# Il deliverable versionato e' il .pdf in file_latex/figure/.
figure_src/anteprime/

# Snapshot del PDF compilato: artefatto, non sorgente. Era stato committato 42
# volte per 359 MB di storia. Si rigenera con latexmk, o si scarica da Overleaf.
tesi_compilata.pdf
